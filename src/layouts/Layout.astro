---
import '../styles/global.css';
import aboutSvg from '../assets/icons/about.svg?raw';
import linkedinSvg from '../assets/icons/linkedin.svg?raw';
import githubSvg from '../assets/icons/github.svg?raw';
import mediumSvg from '../assets/icons/medium.svg?raw';
import emailSvg from '../assets/icons/email.svg?raw';
import sunSvg from '../assets/icons/sun.svg?raw';
import moonSvg from '../assets/icons/moon.svg?raw';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Sahit Katta — personal blog' } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#111111" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Sahit Katta" />

    <!-- RSS -->
    <link rel="alternate" type="application/rss+xml" title="Sahit Katta" href="/rss.xml" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Sahit Katta" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:image" content="https://sahitkatta.github.io/headshot.png" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://sahitkatta.github.io/headshot.png" />

    <title>{title}</title>
    <script is:inline>
      (function() {
        const stored = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (stored === 'dark' || (!stored && prefersDark)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
  </head>
  <body>
    <main>
      <header>
        <a href="/" class="logo-link" aria-label="Sahit Katta home">
          <img src="/logo_black.svg" alt="" class="logo logo-light" />
          <img src="/logo_white.svg" alt="" class="logo logo-dark" />
          <span class="logo-name">Sahit Katta</span>
        </a>
        <div class="header-right">
          <a href="/about" class={currentPath.startsWith('/about') ? 'active' : ''} aria-label="About"><Fragment set:html={aboutSvg} /></a>
          <a href="https://www.linkedin.com/in/sahitkatta/" target="_blank" rel="noopener" aria-label="LinkedIn"><Fragment set:html={linkedinSvg} /></a>
          <a href="https://github.com/sahitkatta" target="_blank" rel="noopener" aria-label="GitHub"><Fragment set:html={githubSvg} /></a>
          <a href="https://sahitkatta.medium.com" target="_blank" rel="noopener" aria-label="Medium"><Fragment set:html={mediumSvg} /></a>
          <a href="mailto:thesahitkatta@gmail.com" aria-label="Email"><Fragment set:html={emailSvg} /></a>
          <button id="theme-toggle" aria-label="Toggle dark mode">
            <Fragment set:html={sunSvg} />
            <Fragment set:html={moonSvg} />
          </button>
        </div>
      </header>
      <slot />
      <footer>
        <p>© {new Date().getFullYear()} Sahit Katta</p>
      </footer>
    </main>
    <script>
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      });
    </script>
  </body>
</html>
